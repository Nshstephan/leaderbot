# Copy this to a real .env (or set these in your host's dashboard).
# NEVER commit the real values to git.

# From @BotFather when you create the bot
BOT_TOKEN=123456:ABC-your-token-here

# The long id from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
SPREADSHEET_ID=your-spreadsheet-id-here

# The ENTIRE service-account JSON, as one line.
# (Open the .json you downloaded, copy all of it, paste here between the quotes.)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com",...}

# Optional: your own Telegram numeric id(s), comma-separated, if you want
# admin powers later. Leave blank if not needed.
ADMIN_IDS=
